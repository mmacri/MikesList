// Prisma schema for Mike's List (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Listing {
  id                 String           @id @default(cuid())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  expiresAt          DateTime
  status             String           @default("active")
  moderationStatus   String           @default("approved")
  title              String
  slug               String
  category           String
  categorySlug       String
  locationType       String
  city               String?
  state              String?
  locationLabel      String
  locationSlug       String
  tags               String
  priceAmount        Int?
  priceUnit          String?
  description        String
  posterEmail        String
  manageTokenHash    String           @unique
  isFeatured         Boolean          @default(false)
  featuredUntil      DateTime?
  lastBumpedAt       DateTime         @default(now())
  lastRenewedAt      DateTime?
  replyCount         Int              @default(0)
  lastReminderStage  String?
  lastReminderSentAt DateTime?

  reports            Report[]

  @@index([status, moderationStatus, expiresAt])
  @@index([categorySlug])
  @@index([locationSlug])
  @@index([isFeatured, featuredUntil])
  @@index([lastBumpedAt])
  @@index([updatedAt])
}

model Report {
  id            String       @id @default(cuid())
  createdAt     DateTime     @default(now())
  listingId     String
  reason        String
  details       String
  reporterEmail String?
  status        String       @default("open")
  ipHash        String?

  listing       Listing      @relation(fields: [listingId], references: [id])

  @@index([listingId])
  @@index([status])
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
